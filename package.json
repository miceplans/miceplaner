{
  "name": "miceplaner",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "pnpm --parallel --filter @miceplans/web --filter @miceplans/api dev",
    "dev:api": "pnpm --filter @miceplans/api dev",
    "dev:desktop": "pnpm --filter @miceplans/desktop dev",
    "build": "pnpm --filter @miceplans/web build",
    "build:desktop": "pnpm --filter @miceplans/desktop build",
    "api:spec": "pnpm --filter @miceplans/api openapi && pnpm --filter @miceplans/web api:gen",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
