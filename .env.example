# Vercel API: Supabase Dashboard > Connect > Transaction pooler URI를 사용한다.
# `postgres`가 아닌 NOBYPASSRLS 역할을 쓴다. Supavisor 사용자명은 <role>.<project-ref> 형식이다.
# sslmode=require과 workaround=supabase-pooler.vercel을 붙이고 값은 절대 브라우저에 노출하지 않는다.
DATABASE_URL=postgresql://miceplans_app.PROJECT_REF:APP_ROLE_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require&workaround=supabase-pooler.vercel
DATABASE_POOL_MAX=1
JWT_SECRET=replace-with-a-long-random-secret
WORKSPACE_ID=miceplans
# 쉼표로 여러 origin을 허용할 수 있다. Tauri 데스크톱 앱도 API를 쓸 때에는
# tauri://localhost,http://tauri.localhost를 반드시 포함한다.
WEB_ORIGIN=https://your-web-project.vercel.app,tauri://localhost,http://tauri.localhost

# 하이웍스 인증을 쓸 때만 설정한다.
OFFICE_TOKEN=
HIWORKS_MAIL_DOMAIN=

# 웹 Vercel 프로젝트에서만 설정하는 공개값이다. API 주소 외의 비밀은 넣지 않는다.
NEXT_PUBLIC_API_URL=https://your-api-project.vercel.app
NEXT_PUBLIC_COLLAB_URL=

# 업로드 원본 저장소 (Supabase Storage S3 호환). 서버 런타임에만 둔다.
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
