# Vercel API: Supabase Dashboard > Connect > Transaction pooler URI를 사용한다.
# `postgres`가 아닌 NOBYPASSRLS 역할을 쓴다. Supavisor 사용자명은 <role>.<project-ref> 형식이다.
# sslmode=require를 붙이고 값은 절대 브라우저에 노출하지 않는다.
DATABASE_URL=postgresql://miceplans_app.PROJECT_REF:APP_ROLE_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
# Supabase 루트 CA(PEM). Dashboard > Project Settings > Database > SSL Configuration에서 내려받는다.
# Supabase 풀러 인증서는 이 CA로 서명되어 있어 없으면 SELF_SIGNED_CERT_IN_CHAIN으로 접속이 실패한다.
# 설정하면 연결 문자열의 sslmode를 무시하고 이 CA로 인증서·호스트 이름을 검증한다. 한 줄로 넣을 때는 줄바꿈을 \n으로 쓴다.
# 운영(NODE_ENV=production)에서 이 값도 sslmode=require/verify-full도 없으면 평문 접속을 막기 위해 시작하지 않는다.
DATABASE_CA_CERT=
DATABASE_POOL_MAX=1
JWT_SECRET=replace-with-a-long-random-secret
WORKSPACE_ID=miceplans
# 쉼표로 여러 origin을 허용할 수 있다. Tauri 데스크톱 앱도 API를 쓸 때에는
# tauri://localhost,http://tauri.localhost를 반드시 포함한다.
WEB_ORIGIN=https://your-web-project.vercel.app,tauri://localhost,http://tauri.localhost

# Swagger UI(/docs)·OpenAPI JSON(/docs-json). 비우면 운영(NODE_ENV=production 또는 Vercel)에서는 닫고 개발에서는 연다.
ENABLE_API_DOCS=
# AI 질의 사용자당 분당 한도와 SSE 전체 마감(ms). 마감은 Vercel 함수 최대 실행 시간(60초)보다 짧게 둔다.
AI_REQUESTS_PER_MINUTE=20
AI_CHAT_DEADLINE_MS=50000

# 하이웍스 인증을 쓸 때만 설정한다.
OFFICE_TOKEN=
HIWORKS_MAIL_DOMAIN=

# 웹 Vercel 프로젝트에서만 설정하는 공개값이다. API 주소 외의 비밀은 넣지 않는다.
NEXT_PUBLIC_API_URL=https://your-api-project.vercel.app
NEXT_PUBLIC_COLLAB_URL=

# 업로드 원본 저장소 (AWS S3). 서버 런타임에만 둔다. 로컬 개발은 FILES_DIR=.local/files 로 대신할 수 있다.
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=   # AWS S3는 비운다. R2 등 S3 호환 저장소만 지정
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
