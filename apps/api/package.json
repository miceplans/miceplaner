{
  "name": "@miceplans/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:vercel": "tsup && mkdir -p public && touch public/index.html",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "tsx --env-file-if-exists=../../.env src/main.ts",
    "openapi": "tsx scripts/export-openapi.ts",
    "seed": "tsx --env-file-if-exists=../../.env scripts/seed-mock.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@miceplans/ai": "workspace:*",
    "@miceplans/contracts": "workspace:*",
    "@miceplans/db": "workspace:*",
    "@miceplans/domain": "workspace:*",
    "@miceplans/knowledge": "workspace:*",
    "@miceplans/queue": "workspace:*",
    "@miceplans/storage": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.1.0",
    "@nestjs/swagger": "^11.1.0",
    "@nestjs/websockets": "^11.1.0",
    "exceljs": "^4.4.0",
    "jose": "^6.0.10",
    "multer": "^2.5.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "tsx": "^4.19.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@miceplans/config": "workspace:*",
    "@nestjs/testing": "^11.1.0",
    "@swc/core": "^1.16.22",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  }
}
