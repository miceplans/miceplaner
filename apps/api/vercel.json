{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build:vercel",
  "outputDirectory": "public",
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 60,
      "includeFiles": "dist/**"
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "/api/[...path].ts" }
  ]
}
